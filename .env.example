# Copy this file to .env. Everything is optional: with no settings at all you get KJV and WEB,
# browser speech recognition in Chrome or Edge, and demo mode.
# These values stay on the server and are never sent to the browser.

# --- Transcription -----------------------------------------------------------
# Deepgram lets you pick the exact church audio input. https://console.deepgram.com
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# Language code, e.g. en, en-US, en-GB, en-NG. Used by both speech engines.
# TRANSCRIPTION_LANGUAGE=en

# --- Licensed Bible translations ---------------------------------------------
# API.Bible (https://api.bible). Your account must be licensed for each translation.
# Find each Bible ID with:  curl -H "api-key: $API_BIBLE_KEY" https://rest.api.bible/v1/bibles
API_BIBLE_KEY=
API_BIBLE_ID_NKJV=
API_BIBLE_ID_NIV=
API_BIBLE_ID_NLT=
API_BIBLE_ID_NASB=
API_BIBLE_ID_NRSV=

# ESV API (https://api.esv.org). Read Crossway's conditions before using it.
ESV_API_KEY=

# --- Server ------------------------------------------------------------------
# DEFAULT_TRANSLATION=kjv
# PORT=3000
# Keep 127.0.0.1 unless the projector runs on a different computer (see README).
# HOST=127.0.0.1
# ALLOWED_HOSTS=192.168.1.50
