{
  "name": "transcribe",
  "version": "0.1.0",
  "description": "Listens to a sermon, detects spoken Bible references, and projects the passage for the congregation.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:browser": "node test/browser/run.mjs",
    "replay": "node scripts/replay-lyrics.mjs",
    "data:build": "node scripts/build-bible-data.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
